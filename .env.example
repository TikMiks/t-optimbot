# Токен бота от @BotFather
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Telegram ID администраторов через запятую (узнать свой можно у @userinfobot)
ADMIN_IDS=123456789

# Начисление владельцу промокода за одну покупку, в рублях.
# Для отдельного промокода значение можно переопределить в админ-панели.
DEFAULT_REWARD=500

# Путь к файлу базы данных
DB_PATH=data/bot.db

# Смещение часового пояса для отображения дат (Москва = 3)
TZ_OFFSET_HOURS=3

# --- Platega (my.platega.io → Настройки) ---
# Без MerchantId опрос платежей не запустится. Secret не коммитьте.
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
PLATEGA_BASE_URL=https://app.platega.io
PLATEGA_POLL_INTERVAL=60
PLATEGA_LOOKBACK_HOURS=48
